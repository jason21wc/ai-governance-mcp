.claude/plans/
.claude/projects/
.claude/scheduled_tasks.lock
# In-repo git worktrees (session-transient) — keep the parent repo's git status clean.
# CE-index exclusion is handled by the indexer's DEFAULT_IGNORE_PATTERNS: this .gitignore
# is NOT consulted for indexing when a .contextignore exists (indexer.py:load_ignore_patterns).
.claude/worktrees/
.pytest-home/

# --- Data that lives outside the checkout (session-268) ---
# index/ is DERIVED from documents/ + the reference library, so it is user-specific
# by construction: two people with this same repo legitimately hold different
# indexes. The public repo already treats it as a build artifact. Rebuild with
# `python -m ai_governance_mcp.extractor`. 309 of 1359 commits used to touch it.
index/
# reference-library/ is USER DATA written at runtime by capture_reference and
# accumulating one person's lessons across ALL their projects. Kept in-repo, a
# capture made while working in an unrelated project dirtied this tree — and a
# dirty checkout blocks a concurrent session's fast-forward merge. Configure with
# AI_GOVERNANCE_REFERENCE_LIBRARY_PATH; default is ~/.ai-governance/.
reference-library/
logs/check-failures/
